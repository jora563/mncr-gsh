# Пустое значение = запросы идут на origin фронтенда и проксируются Vite.
# Если бэкенд сам отдаёт CORS-заголовки, укажите его адрес напрямую:
# VITE_API_URL=http://10.0.0.5:8080
VITE_API_URL=

# Куда проксировать /v1 и /health при разработке
VITE_PROXY_TARGET=

# Keycloak configuration
VITE_KEYCLOAK_URL=http://localhost:9999
VITE_KEYCLOAK_REALM=my-realm
VITE_KEYCLOAK_CLIENT_ID=client
VITE_KEYCLOAK_REDIRECT_URI=http://localhost:5173/callback
